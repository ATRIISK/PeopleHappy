<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.happymart.mapper.ProductMapper">

    <resultMap id="BaseResultMap" type="com.happymart.entity.Product">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
        <result column="price" property="price" jdbcType="DECIMAL"/>
        <result column="original_price" property="originalPrice" jdbcType="DECIMAL"/>
        <result column="image" property="image" jdbcType="VARCHAR"/>
        <result column="images" property="images" jdbcType="VARCHAR"/>
        <result column="category_id" property="categoryId" jdbcType="BIGINT"/>
        <result column="category_name" property="categoryName" jdbcType="VARCHAR"/>
        <result column="sales" property="sales" jdbcType="INTEGER"/>
        <result column="stock" property="stock" jdbcType="INTEGER"/>
        <result column="rating" property="rating" jdbcType="DOUBLE"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="is_deleted" property="deleted" jdbcType="TINYINT"/>
    </resultMap>

    <!-- AI 购物助手关键词召回（v1.11，阶段四，见开发文档 §14）
         只召回【上架】商品（is_deleted=0 AND status=0，手写 SQL 需显式带逻辑删除条件），
         按商品名/描述 LIKE 匹配用户问题，销量高的排前面（热门商品优先命中） -->
    <select id="findForKnowledgeBase" resultMap="BaseResultMap">
        SELECT id, name, description, price, image, category_id, category_name, sales,
               stock, rating, status, create_time, update_time, is_deleted
        FROM product
        WHERE is_deleted = 0
          AND status = 0
          AND (name LIKE CONCAT('%', #{keyword}, '%')
               OR description LIKE CONCAT('%', #{keyword}, '%'))
        ORDER BY sales DESC
        LIMIT #{topK}
    </select>

</mapper>