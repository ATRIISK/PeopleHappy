# =============================================
# 众乐电子商城 - 生产环境变量
#
# 用法：复制为 .env 后填入真实值（.env 已在 .gitignore 里忽略）
#   cp .env.example .env && vim .env
#
# 生成随机强密码（Linux 服务器上执行，各跑一次）：
#   openssl rand -base64 24
# =============================================

# MySQL root 密码（必填，别用 123456）
# 注意：MySQL 容器首次初始化后就固化在数据卷里，之后改这里不生效
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_pwd

# RabbitMQ 账号（必填）
# 不能用 guest/guest：guest 只允许 localhost 登录，后端容器通过容器网络访问会被拒
RABBITMQ_USER=hm_admin
RABBITMQ_PASSWORD=CHANGE_ME_mq_pwd

# 支付宝异步回调地址（必填）
# 已购域名：happy-mart.pw，服务器公网 IP：115.29.29.83
# 备案期间用 IP（域名走 80 会被阿里云阻断），备案通过后改成 http://happy-mart.pw/api/pay/notify
# 改这里之后要 docker compose up -d backend 重建容器才生效
ALIPAY_NOTIFY_URL=http://115.29.29.83/api/pay/notify

# JWT 签名密钥（必填，建议 openssl rand -base64 32 生成，至少 32 位）
# 不填会回落到代码仓库里的公开默认值，等于任何人都能伪造登录 token
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars

# 智谱 GLM API Key（可选）
# 不填服务照常启动，AI 购物助手调用时降级提示「AI 服务暂不可用」。
# 注意：要么整行留着但不写等号后的值、要么直接注释掉，不要写成 GLM_API_KEY= 
# （compose 会注入空串，覆盖 application.yml 的 dummy 兜底值导致启动失败；
#   compose 里已用 ${GLM_API_KEY:-dummy} 兜底，正常不会踩到）
# GLM_API_KEY=你的key
